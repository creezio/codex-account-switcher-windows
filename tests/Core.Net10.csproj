<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWindowsForms>true</UseWindowsForms>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <StartupObject>TestRunner</StartupObject><AssemblyName>CoreNet10.Tests</AssemblyName><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);SYSLIB0057</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../src/*.cs"/><Compile Include="../desktop/JsonCompatibility.cs"/><Compile Include="../desktop/AssemblyInfo.cs"/>
    <Compile Include="TestRunner.cs;ResetTests.cs;InstanceTests.cs;SimpleWorkflowTests.cs;ToolTunnelTests.cs;ResourceCatalogTests.cs;RelayTests.cs;GeneralRelayTests.cs;ProductTests.cs;ConsoleTests.cs;RemoteTests.cs;AssistanceTests.cs"/>
  </ItemGroup>
</Project>

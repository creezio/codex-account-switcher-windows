<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <StartupObject>Creezio.Switcher.Desktop.DesktopApp</StartupObject>
    <AssemblyName>CodexAccountSwitcher</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);SYSLIB0057</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../src/*.cs" Link="Engine/%(Filename)%(Extension)" />
    <Compile Include="../tests/InstanceSmoke.cs" Link="Validation/InstanceSmoke.cs" />
  </ItemGroup>
</Project>
